# Koneksi MySQL: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://sunnah:password@127.0.0.1:3306/sunnah_aqiqah"

# Rahasia untuk menandatangani cookie sesi admin (min. 32 karakter).
# Buat dengan: openssl rand -base64 32
SESSION_SECRET=""

# Akun admin pertama, dibuat oleh `pnpm db:seed`
ADMIN_EMAIL="admin@sunnahaqiqah.com"
ADMIN_PASSWORD=""

# WA Gateway (https://wag.homeitop.web.id) untuk notifikasi pesanan otomatis.
# API key dari dashboard gateway: User → Settings → Generate New API Key.
# WA_SENDER = nomor perangkat yang sudah di-pair (scan QR) di dashboard gateway.
# Kosongkan bila tidak dipakai: pesanan tetap berjalan lewat tautan wa.me saja.
WA_GATEWAY_URL="https://wag.homeitop.web.id"
WA_API_KEY=""
WA_SENDER=""
